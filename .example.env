# Copy to .env and edit. Every value here is the built-in default.

# --- Speech to text ---------------------------------------------------------
# distil-large-v3 is English-only and fastest; large-v3-turbo if you need other languages.
STT_MODEL=distil-large-v3
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_LANGUAGE=en
STT_BEAM_SIZE=1
# Drop segments whisper thinks are not speech — this is what stops background noise becoming a
# plausible sentence. Measured: every real utterance (clean, 0dB SNR, whispered, one word,
# clipped) scored under 0.04; silence and hiss scored over 0.11.
# Lower it to be stricter; raise it if genuine speech is being discarded.
STT_MAX_NO_SPEECH=0.1

# --- Addressing ---------------------------------------------------------------
# He answers only an utterance that names him, and the sentence naming him marks where the
# request starts — "Where are my keys. Tobias, what's the weather?" asks about the weather.
# Leave empty to disable the gate: right for test_stt.py, or a headset where you are alone.
STT_WAKE_WORD=Tobias
# Seconds after he STOPS REPLYING during which you can answer back without naming him again.
# Measured from the end of his reply, not the end of your question. 0 always requires the name.
# The startup greeting does not count — an announcement is not a reply and opens no window.
STT_FOLLOW_UP_S=10

# --- Barge-in -----------------------------------------------------------------
# Naming him while he is talking cuts him off mid-word. If the interruption carries a request
# ("Tobias, what's the weather") it becomes the next question; if it only tells him to be quiet
# ("Tobias stop") he simply stops. Either way he only remembers the part he got to say.
# Set false to make him unstoppable until he finishes: quieter on the GPU, and the right choice
# on speakers, where his own voice can trip his own wake word.
STT_BARGE_IN=true
# Milliseconds of SPEECH — not silence, unlike every other _MS setting here. How much audio to
# gather before asking whisper whether his name was in it, so it is the floor on how fast he can
# react. 500ms is enough to return "Tobias" (measured); below ~400ms it returns a fragment and
# the no-speech gate discards it. Unrelated to VAD_SILENCE_MS: that one is about when your turn
# ends, this one is about how much audio whisper needs to recognise a word.
STT_BARGE_IN_MS=600

# --- Voice activity detection -----------------------------------------------
# Speech probability above which a frame counts as speech. Raise if noise triggers it.
VAD_THRESHOLD=0.5
# Silence needed to close an utterance, and pure dead time in every turn — the single largest
# latency knob. Raise if you get cut off while pausing to think mid-sentence.
VAD_SILENCE_MS=700
# Utterances shorter than this are discarded as coughs, clicks, etc.
VAD_MIN_SPEECH_MS=250
# Audio kept from before speech was detected. Silero needs a moment to fire and whatever it
# took is already gone — 200ms measurably lost the first word. This costs nothing: the audio is
# buffered anyway and whisper pads to 30s regardless.
VAD_SPEECH_PAD_MS=400
# Hard cap: an utterance is flushed at this length whether or not you stopped talking.
MAX_UTTERANCE_S=30

# --- Text to speech ---------------------------------------------------------
# British male voices: bm_george, bm_lewis, bm_daniel, bm_fable. A bm_/bf_ prefix is
# required — kokoro is loaded with the British G2P and rejects other voices.
TTS_VOICE=bm_lewis
TTS_SPEED=1.1
# Kokoro runs on torch and needs the CUDA build pinned in requirements.txt: 27x realtime on
# the GPU against 1.9x on CPU. Set to cpu only to free the ~350 MiB it holds.
TTS_DEVICE=cuda

# --- LLM --------------------------------------------------------------------
# Required for the llm module. The stt and tts scripts run fine without it.
OPENAI_API_KEY=
# gpt-4.1-mini ($0.40/$1.60 per 1M) supports the sampling knobs below. The gpt-5 family does
# NOT — it rejects a custom temperature and pins the penalties at 0, so avoid it here.
# gpt-4.1-nano is cheaper ($0.10/$0.40) but noticeably worse at holding a persona.
LLM_MODEL=gpt-4.1-mini
# Maximum creativity: temperature and top_p at 1, penalties nudging it off well-worn phrasing.
LLM_TEMPERATURE=1.0
LLM_TOP_P=1.0
LLM_PRESENCE_PENALTY=0.6
LLM_FREQUENCY_PENALTY=0.3
# Unset means the model's own maximum. Set a number only to cap a runaway reply.
# LLM_MAX_TOKENS=2000

# --- Personality --------------------------------------------------------------
# Deliberately NOT here. The dials are state, not configuration, because TOBIAS changes them
# himself — so they live in state.json, which he writes and which is gitignored. Defaults are
# in config.py; edit state.json to override them, or delete it to go back to the defaults.
#
#   {"llm_sarcasm": 8, "llm_warmth": 10, "llm_anxiety": 6}
#
# Comic, social, emotional. British English, maximum expressiveness and maximum disfluency are
# fixed character rather than dials — they live in llm/prompts/primary.py.

# --- Audio devices ----------------------------------------------------------
# Indices from `sounddevice.query_devices()`. Leave unset for the system defaults, which is
# usually what you want. Inputs and outputs share ONE index space, so the microphone you want
# and the speakers you want have unrelated numbers and it is easy to swap them by mistake.
#   py -3.12 -c "import sounddevice as sd; print(sd.query_devices())"
# The columns are (in, out) channel counts: a device showing (2, 0) is a microphone and cannot
# be an OUTPUT_DEVICE, whatever PortAudio's error message claims.
# INPUT_DEVICE=3
# OUTPUT_DEVICE=9
